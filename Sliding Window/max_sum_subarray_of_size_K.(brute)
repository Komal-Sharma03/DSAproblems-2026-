#include <bits/stdc++.h>
using namespace std;

int MaxSumSubarray(vector<int> arr, int k){
    int maxSum=0;
    int n=arr.size();
    for(int i=0;i<=n-k;i++){
        int currSum=0;
        for(int j=0;j<k;j++){
            currSum+=arr[i+j];
        }
        maxSum=max(maxSum,currSum);
    }

    return maxSum;
}

int main(){
    vector<int> arr={2,3};
    int k=1;
    cout<<MaxSumSubarray(arr,k);
   
    return 0;
}
